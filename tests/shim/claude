#!/bin/sh
# The claude shim: plays the roles the relay sees. State under $BATON_SHIM: rows.json (what
# agents --json answers), calls.log (every call's argv, one line each), now, and the knobs a
# scenario sets — bg.stderr (printed on stderr by --bg) and bg.fail (--bg prints no backgrounded
# line and exits with the file's number), bg.norow (no row appears, as for a worker that crashed
# before init), bg.settled (the line the service writes to its daemon.log for such a crash), and
# resume.note, resume.stream and resume.status (what --bg --resume prints, on which stream, with
# which exit code; resume.note.<session> and resume.status.<session> answer for that session alone),
# stop.linger (how many listings after a stop still show the stopped session's pid), stop.fail
# (how many listings after a stop fail outright), stop.status (the stop itself fails with that exit code)
# bg.cursor (a cursor-control prefix that cli_plain does not strip), bg.hidden-reads (hide a newly
# started worker from this many listings while keeping its live row internally, so stop can reach it)
# and env.claude (each call also records the names of the CLAUDE* variables it carried).
# The onboarding roles: version (what --version prints) and version.fail (it refuses the flag);
# judge.answer (what -p prints), judge.status and judge.stderr (it fails), judge.hang (it never
# answers, so the judgment request's deadline is what ends it).
set -eu
S=${BATON_SHIM:?}

record() {
  line="[cwd $PWD] claude"
  for a in "$@"; do
    if [ "${#a}" -gt 200 ]; then a="<prompt>"; fi
    case "$a" in *" "*|*"·"*) line="$line '$a'" ;; *) line="$line $a" ;; esac
  done
  printf '%s\n' "$line" >> "$S/calls.log"
  # env.claude: also record the names of the CLAUDE* variables the call carried, because a process
  # started from inside a Claude Code session inherits them and they tie the new session to that one.
  if [ -f "$S/env.claude" ]; then
    printf '[env] %s\n' "$(env | sed -n 's/^\(CLAUDE[A-Z0-9_]*\)=.*/\1/p' | sort | tr '\n' ' ')" >> "$S/calls.log"
  fi
}

case "${1:-}" in
  agents)
    record "$@"
    # A stop is not synchronous: for the reads a scenario names the listing fails, then still shows
    # the stopped session's pid, and only then does the pid come off the row.
    n=$(cat "$S/fail.pending" 2>/dev/null || echo 0)
    if [ "$n" -gt 0 ]; then echo $((n - 1)) > "$S/fail.pending"; exit 1; fi
    for lf in "$S"/linger.*; do
      [ -f "$lf" ] || continue
      n=$(cat "$lf")
      if [ "$n" -gt 0 ]; then echo $((n - 1)) > "$lf"; continue; fi
      jq -c --arg id "${lf##*/linger.}" 'map(if .id == $id and .pid != null
                                             then . + {stoppedPid: .pid, pid: null} else . end)' \
        "$S/rows.json" > "$S/rows.json.tmp"
      mv "$S/rows.json.tmp" "$S/rows.json"
      rm -f "$lf"
    done
    n=$(cat "$S/bg.hidden.pending" 2>/dev/null || echo 0)
    if [ "$n" -gt 0 ]; then
      echo $((n - 1)) > "$S/bg.hidden.pending"
      jq -c --arg id "$(cat "$S/bg.hidden.id")" 'map(select(.id != $id))' "$S/rows.json"
    else
      cat "$S/rows.json"
    fi
    ;;
  --bg)
    record "$@"
    # The resume roles. A scenario sets resume.note to the exact line the CLI prints — the success
    # line by default, or one of the copy-fork note: variants captured live (item 46) — resume.stream
    # to send it to stderr instead of stdout, and resume.status to make the command exit non-zero.
    # A note naming a copy also puts the copy's row in the listing, because that is what a fork
    # leaves behind: a second live session under a new id, which the next tick must see.
    if [ "${2:-}" = --resume ]; then
      sid=${3:-}
      if [ -f "$S/resume.note.$sid" ]; then note=$(cat "$S/resume.note.$sid")
      elif [ -f "$S/resume.note" ]; then note=$(cat "$S/resume.note")
      elif jq -e --arg s "$sid" 'any(.[]; .sessionId == $s and .pid != null)' "$S/rows.json" > /dev/null; then
        # The session is still running — no stop reached it, or one has not landed — so the flagless
        # resume starts a copy, as the real CLI does (item 46, and M05's live proof).
        note="note: session ${sid%%-*} is already running in the background, so this started a copy as c0b1e5e1."
      else note="note: woke session ${sid%%-*} with its saved options (-n, --effort, --permission-mode, --settings, --model)."
      fi
      case "$note" in
        *"started a copy"*)
          # The note names the job id; the row is what carries the copy's session id, and the two
          # differ — the job id is the session id's first eight characters (item 46). The match is
          # the family and not one phrasing, so a fixture can carry the generic variant too.
          copy=$(printf '%s' "$note" | sed -n 's/.* as \([0-9a-f]*\).*/\1/p')
          jq -c --arg id "$copy" --arg cwd "$PWD" \
            '. + [{pid: 4299, id: $id, cwd: $cwd, kind: "background", startedAt: 1789200000000,
                   sessionId: "\($id)-0000-4000-8000-000000000000",
                   name: "Baton · Fixture · M02", status: "busy", state: "working"}]' \
            "$S/rows.json" > "$S/rows.json.tmp"
          mv "$S/rows.json.tmp" "$S/rows.json"
          ;;
        *"woke session "*)
          # The session is running again under its own id, so the pid a stop took comes back.
          jq -c --arg s "$sid" 'map(if .sessionId == $s and has("stoppedPid")
                                    then (.pid = .stoppedPid | del(.stoppedPid)) else . end)' \
            "$S/rows.json" > "$S/rows.json.tmp"
          mv "$S/rows.json.tmp" "$S/rows.json"
          ;;
      esac
      [ ! -f "$S/bg.color" ] || note=$(printf '%s' "$note" | sed "s/\\([0-9a-f]\\{8\\}\\)/$(printf '\033')[36m\\1$(printf '\033')[39m/g")
      # The real CLI prints a `backgrounded · <id>` line on stdout for a resume whichever way it
      # went — the woken id on a success, the copy's on a fork (item 46). The fixtures carry it so
      # that stdout is as ambiguous here as it is live, and a classifier that ever keyed on it would
      # be caught rather than passing every scenario.
      if [ -n "${copy:-}" ]; then printf 'backgrounded · %s\n' "$copy"
      else printf 'backgrounded · %s\n' "${sid%%-*}"
      fi
      if [ "$(cat "$S/resume.stream" 2>/dev/null || echo stdout)" = stderr ]; then
        printf '%s\n' "$note" >&2
      else
        printf '%s\n' "$note"
      fi
      exit "$(cat "$S/resume.status.$sid" 2>/dev/null || cat "$S/resume.status" 2>/dev/null || echo 0)"
    fi
    name=; shift
    while [ $# -gt 1 ]; do
      case "$1" in -n) name=$2; shift ;; esac
      shift
    done
    if [ -f "$S/bg.stderr" ]; then cat "$S/bg.stderr" >&2; fi
    if [ -f "$S/bg.fail" ]; then exit "$(cat "$S/bg.fail")"; fi
    n=$(cat "$S/bg.count" 2>/dev/null || echo 0); n=$((n + 1)); echo "$n" > "$S/bg.count"
    id=$(printf '0badc0d%d' "$n")
    # bg.color: the id wrapped in the colour escapes the real CLI prints whenever FORCE_COLOR is in
    # the environment, redirected or not (D-050). The row and the sidecar still carry the plain id.
    shown=$id
    [ ! -f "$S/bg.color" ] || shown=$(printf '%s[36m%s%s[39m' "$(printf '\033')" "$id" "$(printf '\033')")
    [ ! -f "$S/bg.cursor" ] || printf '\033[?25l'
    printf 'backgrounded · %s · %s\n' "$shown" "$name"
    printf '  claude agents             list sessions\n  claude attach %s    open in this terminal\n  claude logs %s      show recent output\n  claude stop %s      stop this session\n' "$id" "$id" "$id"
    if [ ! -f "$S/bg.norow" ]; then
      jq -c --arg id "$id" --arg name "$name" --arg cwd "$PWD" --arg n "$n" \
        '. + [{pid: (4240 + ($n | tonumber)), id: $id, cwd: $cwd, kind: "background", startedAt: 1789200000000,
               sessionId: "\($id)-0000-4000-8000-000000000000", name: $name, status: "busy", state: "working"}]' \
        "$S/rows.json" > "$S/rows.json.tmp"
      mv "$S/rows.json.tmp" "$S/rows.json"
    fi
    if [ -f "$S/bg.hidden-reads" ]; then
      printf '%s\n' "$id" > "$S/bg.hidden.id"
      cp "$S/bg.hidden-reads" "$S/bg.hidden.pending"
    fi
    if [ -f "$S/bg.settled" ]; then
      printf '[2026-09-12T00:00:00.100Z] [bg] bg settled %s (crashed): %s\n' "$id" "$(cat "$S/bg.settled")" >> "$S/daemon.log"
    fi
    ;;
  --version)
    # M4's shape check: the one question the judgment role asks of the binary before it uses it.
    # A scenario sets version.fail to make the binary answer nothing, which is what an installed CLI
    # too old to be asked looks like.
    record "$@"
    if [ -f "$S/version.fail" ]; then echo 'claude: unknown option --version' >&2; exit 1; fi
    cat "$S/version" 2>/dev/null || echo '2.1.278 (Claude Code)'
    ;;
  -p)
    # The judgment request: a foreground print-mode call, whose whole answer is what the scenario's
    # judge.answer holds. judge.status makes it exit non-zero and judge.hang makes it never answer,
    # which are the two terminal outcomes besides an answer that the role has to have.
    record "$@"
    if [ -f "$S/judge.hang" ]; then sleep 600; exit 0; fi
    if [ -f "$S/judge.status" ]; then
      if [ -f "$S/judge.stderr" ]; then cat "$S/judge.stderr" >&2; else echo 'claude: the request failed' >&2; fi
      exit "$(cat "$S/judge.status")"
    fi
    cat "$S/judge.answer" 2>/dev/null || printf 'GOAL: a fixture project.\nDONE: every milestone reads done.\nCONSTRAINTS: POSIX shell only.\nNON-GOALS: a rewrite in another language.\n'
    ;;
  stop)
    record "$@"
    # stop.status: the stop fails with that exit code and changes nothing, as a stop the CLI refused.
    if [ -f "$S/stop.status" ]; then echo "error: could not stop ${2:-}" >&2; exit "$(cat "$S/stop.status")"; fi
    # A stop takes the pid off the row and leaves the row, which is what the real CLI does once the
    # stop lands: liveness is the pid. The pid is kept beside the row so a resume can give it back,
    # and a scenario's later `agents --json` reads the session as stopped in between — which is
    # what `stop_settle` waits for before it resumes. With stop.linger or stop.fail the pid comes off
    # only after that many listings, in the agents branch.
    [ ! -f "$S/stop.fail" ] || cp "$S/stop.fail" "$S/fail.pending"
    if [ -f "$S/stop.linger" ]; then
      cp "$S/stop.linger" "$S/linger.${2:-}"
    else
      jq -c --arg id "${2:-}" 'map(if .id == $id and .pid != null
                                   then . + {stoppedPid: .pid, pid: null} else . end)' \
        "$S/rows.json" > "$S/rows.json.tmp"
      mv "$S/rows.json.tmp" "$S/rows.json"
    fi
    ;;
  *)
    record "$@"
    echo "shim: unplayed call: $*" >&2
    exit 1
    ;;
esac
