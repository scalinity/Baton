#!/bin/sh
# The claude shim: plays the roles the relay sees. State under $BATON_SHIM: rows.json (what
# agents --json answers), calls.log (every call's argv, one line each), now, and the knobs a
# scenario sets — bg.stderr (printed on stderr by --bg) and bg.fail (--bg prints no backgrounded
# line and exits with the file's number), bg.norow (no row appears, as for a worker that crashed
# before init), bg.settled (the line the service writes to its daemon.log for such a crash), and
# resume.note, resume.stream and resume.status (what --bg --resume prints, on which stream, with
# which exit code).
set -eu
S=${BATON_SHIM:?}

record() {
  line="[cwd $PWD] claude"
  for a in "$@"; do
    if [ "${#a}" -gt 200 ]; then a="<prompt>"; fi
    case "$a" in *" "*|*"·"*) line="$line '$a'" ;; *) line="$line $a" ;; esac
  done
  printf '%s\n' "$line" >> "$S/calls.log"
}

case "${1:-}" in
  agents)
    record "$@"
    cat "$S/rows.json"
    ;;
  --bg)
    record "$@"
    # The resume roles. A scenario sets resume.note to the exact line the CLI prints — the success
    # line by default, or one of the copy-fork note: variants captured live (item 46) — resume.stream
    # to send it to stderr instead of stdout, and resume.status to make the command exit non-zero.
    # A note naming a copy also puts the copy's row in the listing, because that is what a fork
    # leaves behind: a second live session under a new id, which the next tick must see.
    if [ "${2:-}" = --resume ]; then
      sid=${3:-}
      if [ -f "$S/resume.note" ]; then note=$(cat "$S/resume.note")
      else note="note: woke session ${sid%%-*} with its saved options (-n, --effort, --permission-mode, --settings, --model)."
      fi
      case "$note" in
        *"started a copy"*)
          # The note names the job id; the row is what carries the copy's session id, and the two
          # differ — the job id is the session id's first eight characters (item 46). The match is
          # the family and not one phrasing, so a fixture can carry the generic variant too.
          copy=$(printf '%s' "$note" | sed -n 's/.* as \([0-9a-f]*\).*/\1/p')
          jq -c --arg id "$copy" --arg cwd "$PWD" \
            '. + [{pid: 4299, id: $id, cwd: $cwd, kind: "background", startedAt: 1789200000000,
                   sessionId: "\($id)-0000-4000-8000-000000000000",
                   name: "Baton · Fixture · M02", status: "busy", state: "working"}]' \
            "$S/rows.json" > "$S/rows.json.tmp"
          mv "$S/rows.json.tmp" "$S/rows.json"
          ;;
      esac
      [ ! -f "$S/bg.color" ] || note=$(printf '%s' "$note" | sed "s/\\([0-9a-f]\\{8\\}\\)/$(printf '\033')[36m\\1$(printf '\033')[39m/g")
      # The real CLI prints a `backgrounded · <id>` line on stdout for a resume whichever way it
      # went — the woken id on a success, the copy's on a fork (item 46). The fixtures carry it so
      # that stdout is as ambiguous here as it is live, and a classifier that ever keyed on it would
      # be caught rather than passing every scenario.
      if [ -n "${copy:-}" ]; then printf 'backgrounded · %s\n' "$copy"
      else printf 'backgrounded · %s\n' "${sid%%-*}"
      fi
      if [ "$(cat "$S/resume.stream" 2>/dev/null || echo stdout)" = stderr ]; then
        printf '%s\n' "$note" >&2
      else
        printf '%s\n' "$note"
      fi
      exit "$(cat "$S/resume.status" 2>/dev/null || echo 0)"
    fi
    name=; shift
    while [ $# -gt 1 ]; do
      case "$1" in -n) name=$2; shift ;; esac
      shift
    done
    if [ -f "$S/bg.stderr" ]; then cat "$S/bg.stderr" >&2; fi
    if [ -f "$S/bg.fail" ]; then exit "$(cat "$S/bg.fail")"; fi
    n=$(cat "$S/bg.count" 2>/dev/null || echo 0); n=$((n + 1)); echo "$n" > "$S/bg.count"
    id=$(printf '0badc0d%d' "$n")
    # bg.color: the id wrapped in the colour escapes the real CLI prints whenever FORCE_COLOR is in
    # the environment, redirected or not (D-050). The row and the sidecar still carry the plain id.
    shown=$id
    [ ! -f "$S/bg.color" ] || shown=$(printf '%s[36m%s%s[39m' "$(printf '\033')" "$id" "$(printf '\033')")
    printf 'backgrounded · %s · %s\n' "$shown" "$name"
    printf '  claude agents             list sessions\n  claude attach %s    open in this terminal\n  claude logs %s      show recent output\n  claude stop %s      stop this session\n' "$id" "$id" "$id"
    if [ ! -f "$S/bg.norow" ]; then
      jq -c --arg id "$id" --arg name "$name" --arg cwd "$PWD" --arg n "$n" \
        '. + [{pid: (4240 + ($n | tonumber)), id: $id, cwd: $cwd, kind: "background", startedAt: 1789200000000,
               sessionId: "\($id)-0000-4000-8000-000000000000", name: $name, status: "busy", state: "working"}]' \
        "$S/rows.json" > "$S/rows.json.tmp"
      mv "$S/rows.json.tmp" "$S/rows.json"
    fi
    if [ -f "$S/bg.settled" ]; then
      printf '[2026-09-12T00:00:00.100Z] [bg] bg settled %s (crashed): %s\n' "$id" "$(cat "$S/bg.settled")" >> "$S/daemon.log"
    fi
    ;;
  stop)
    record "$@"
    ;;
  *)
    record "$@"
    echo "shim: unplayed call: $*" >&2
    exit 1
    ;;
esac
