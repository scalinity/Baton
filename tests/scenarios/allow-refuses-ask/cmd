echo "== item 42 is unrun, so an ask rule is refused rather than written and found out about =="
"$BATON" allow M02 'ask:Bash(rm:*)' || echo "status $?"
"$BATON" allow M02 'ask Bash(rm:*)' || echo "status $?"
echo "== and a rule is a string, one line, not empty and not a settings fragment =="
"$BATON" allow M02 '' || echo "status $?"
"$BATON" allow M02 '{"ask":["Bash(rm:*)"]}' || echo "status $?"
echo "== a milestone Baton never dispatched has no allowlist it earned =="
"$BATON" allow M04 'Bash(xcodebuild:*)' || echo "status $?"
echo "== a list, a quoted string and a number are JSON, and no permission rule is =="
"$BATON" allow M02 '["Bash(rm:*)"]' || echo "status $?"
"$BATON" allow M02 '"Bash(xcodebuild:*)"' || echo "status $?"
"$BATON" allow M02 '42' || echo "status $?"
echo "== and a rule over 1 KB is refused rather than written without its record =="
"$BATON" allow M02 'Bash(:*)' || echo "status $?"
echo "== and one rule per call: a rule with a newline in it is two rules =="
"$BATON" allow M02 "$(printf 'Bash(a:*)\nBash(b:*)')" || echo "status $?"
