set -e
cp "$SCENARIO/now" "$SHIM/now"
echo "== the five-hour window reads 95 and resets at 16:00: the tick pauses, and because it pauses nothing runs and nothing writes a fresher reading =="
"$BATON" tick
"$BATON" status
echo
echo "== past 16:00 with that same file still the only one there: a reading of a window that has ended is no reading at all, which is what lets the pause lift on a night nothing else ran =="
printf '2026-09-12T16:30:00+01:00\n' > "$SHIM/now"
"$BATON" tick
"$BATON" status
echo "-- lifted on the expiry alone, with no newer status file than the one that caused the pause --"
grep -q '"kind":"hold_lifted","model":"all","cause":"budget"' "$BATON_HOME/log.jsonl"
[ "$(jq -r '.rate_limits.five_hour.used_percentage' "$BATON_HOME/status/f1.json")" = 95 ]
