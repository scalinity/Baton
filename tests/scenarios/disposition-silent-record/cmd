set -eu
# The silent record's own guard, which is the half the two stale-lock scenarios cannot show. Those
# prove that a HOST-EXPLAINED condition writes its event and calls no notifier; this proves that
# nothing else can. The failure mode of the fourth disposition is a condition that needed a person
# and got an event nobody will read, so the class is checked against the table rather than taken
# from the caller.
. "$ROOT/tests/lib-load.sh"
lock_take

echo '=== the one class the table calls HOST-EXPLAINED writes its event, and channel says which it is'
record_only "" "" "" "" baton-unhealthy project '{"detail":"the lock was cleared and the tick proceeded"}'

echo '=== a class that reaches a person cannot be recorded silently, whatever the caller believes'
for c in asking question merge-failed dispatch-failed main-broken unfinished-twice; do
  status=0
  record_only Fixture M02 s 1 "$c" lane '{"detail":"a person is owed this"}' 2>/dev/null || status=$?
  echo "  $c -> exit $status"
done

echo
echo '=== gap is a notification and this writer takes escalations, so it is refused here on the first'
echo '=== guard rather than on the disposition. The honest reason is the one shown, not swallowed.'
status=0
record_only "" "" "" "" gap project '{"detail":"Baton was not running for 12 m"}' || status=$?
echo "  gap -> exit $status"

echo
echo '=== the notification half. record_notification is the same act on the other channel, and its'
echo '=== guard is the one that has to work hardest: gap is not HOST-EXPLAINED by its class, it is'
echo '=== HOST-EXPLAINED for an event whose own evidence explains it — so this writer admits and'
echo '=== refuses the same class, on the fields and nothing else.'
record_notification "" "" "" "" gap 2026-09-12T10:00:00+01:00 \
  '{"gap_seconds":7200,"marker":"2026-09-12T10:00:00+01:00","detail":"the host was asleep for 1 h 58 m of it","host":{"assessed":"explained","sleep_seconds":7100,"longest_awake_seconds":50}}'
echo '=== and every other reading of the same gap, each of which a person is owed'
for h in '{"assessed":"unexplained","sleep_seconds":0}' '{"assessed":"unknown","reason":"history-unreadable"}' 'null'; do
  status=0
  record_notification "" "" "" "" gap 2026-09-12T11:00:00+01:00 \
    "{\"gap_seconds\":7200,\"detail\":\"a person is owed this\",\"host\":$h}" 2>/dev/null || status=$?
  echo "  host $h -> exit $status"
done
echo '=== a notification class that is never HOST-EXPLAINED, whatever is attached to it'
for c in stall rate_limit takeover-silent; do
  status=0
  record_notification Fixture M02 s 1 "$c" "" '{"detail":"a person is owed this","host":{"assessed":"explained"}}' 2>/dev/null || status=$?
  echo "  $c -> exit $status"
done
echo '=== and the two refusals this writer inherits from the pair above: a class outside the list, and'
echo '=== a carries that is not JSON'
status=0
record_notification "" "" "" "" baton-unhealthy "" '{"detail":"an escalation class, on the wrong writer"}' 2>/dev/null || status=$?
echo "  baton-unhealthy -> exit $status"
status=0
record_notification "" "" "" "" gap "" 'not json' 2>/dev/null || status=$?
echo "  carries not json -> exit $status"

echo
echo '=== the refusals a person reads, on the stream they belong to'
record_only Fixture M02 s 1 asking lane '{"detail":"a person is owed this"}' || true
record_only "" "" "" "" baton-unhealthy sideways '{"detail":"not a scope"}' || true
record_only "" "" "" "" permission project '{"detail":"not a class"}' || true
record_only "" "" "" "" baton-unhealthy project 'not json' || true

echo
echo '=== the refusals the notification writer prints, on the stream they belong to'
record_notification "" "" "" "" gap "" '{"detail":"a person is owed this"}' || true
record_notification "" "" "" "" prompt-lost "" '{"detail":"a person is owed this"}' || true

echo
echo '=== what was written: two lines, one per channel that is not a channel, and the notifier was'
echo '=== not called at all — calls.log is empty'
jq -c '{kind, class, scope, key, channel}' "$BATON_HOME/log.jsonl"
