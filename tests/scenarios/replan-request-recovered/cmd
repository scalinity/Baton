set -eu
# M02's park was raised without a Mac message, and the tick that raised it ended before it could make
# the request: nothing is owed and no `requested` event names the park. A park like that has told
# nobody and has nothing coming for it, so the replan pass asks the request's gate again — it holds,
# as it did at the raise — and makes the request from the standing park: `plan_owed.replan` names it by
# its `at`, and the `requested` event follows. Nothing reaches the Mac.
"$BATON" tick || true
printf '%s\n' '--- the registration ---'
jq -c '{plan_format, owed: (if .plan_owed then (.plan_owed | {owner, reason, replan: (if .replan then (.replan | {milestone, class, at}) else null end)}) else null end), start: [.start.eligible[] | .milestone]}' "$BATON_HOME/projects/Fixture/project.json"
printf '%s\n' '--- what the ticks recorded ---'
jq -c 'select(.at >= "2026-09-19T08") | {kind, milestone, class, channel, receipt: (.carries.reread.policy // null), outcome, attempts, replan, why, how, attempt}' "$BATON_HOME/log.jsonl"
printf '%s\n' '--- status ---'
"$BATON" status || true
