#!/bin/sh
set -eu
base=$(cd "$SHIM/.." && pwd)
source=$base/Fixture
linked=$base/linked
if [ ! -d "$linked" ]; then git -C "$source" worktree add -q --detach "$linked" HEAD; fi
cp "$ROOT/install.sh" "$linked/install.sh"
for component in bin lib hooks notify launchd; do
  rm -rf "$linked/$component"
  cp -R "$ROOT/$component" "$linked/$component"
done
printf '\n# fixture-only unmerged library content\n' >> "$linked/lib/tick.sh"
# The runner's seam tests these exact working-tree bytes, wherever ROOT itself lives.
HOME=$base BATON_HOME="$base/harness-home" BATON_CLAUDE_ICON="$ROOT/tests/scenarios/install/icon.icns" \
  sh "$linked/install.sh" > "$base/install.out"
# The installed libraries are a bundle named for their own content, and the installed baton names
# it (D-131), so the bytes are checked where that copy would actually source them from.
pin=$(sed -n 's/^baton_bundle=//p' "$base/harness-home/bin/baton")
[ -n "$pin" ]
cmp -s "$linked/lib/tick.sh" "$base/harness-home/bin/lib/$pin/tick.sh"
jq -e --arg canonical "$source" '.path == $canonical' "$base/harness-home/projects/Fixture/project.json" > /dev/null
echo 'harness mode installs the linked fixture bytes and registers its canonical checkout'
# Turning off the seam must restore production behavior, even though the target is disposable.
if HOME=$base BATON_HOME="$base/refused-home" BATON_INSTALL_TEST=0 sh "$linked/install.sh" > "$base/refused.out" 2>&1; then exit 1;
else result=$?; fi
[ "$result" -eq 2 ]
[ ! -e "$base/refused-home" ]
cat "$base/refused.out"
echo 'production mode refuses the linked tree before writing'
cp "$ROOT/install.sh" "$source/install.sh"
if HOME=$base BATON_HOME="$base/refused-home" BATON_INSTALL_TEST=0 sh "$source/install.sh" > "$base/refused.out" 2>&1; then exit 1;
else result=$?; fi
[ "$result" -eq 2 ]
[ ! -e "$base/refused-home" ]
cat "$base/refused.out"
echo 'production mode refuses uncommitted install inputs on main'
