{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(sh tests/run.sh:*)",
      "Bash(jq:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Write(//Users/danny/.baton/log.jsonl)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "BATON_HOME='@TMP@/home' BATON_PROJECT='Other' BATON_MILESTONE='M05' @TMP@/home/bin/statusline"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "BATON_HOME='@TMP@/home' BATON_PROJECT='Other' BATON_MILESTONE='M05' @TMP@/home/bin/stop-gate"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "BATON_HOME='@TMP@/home' BATON_PROJECT='Other' BATON_MILESTONE='M05' @TMP@/home/bin/stop-failure"
          }
        ]
      }
    ]
  }
}
