set -eu
# Cut the milestone branch before the brief lands on main, as a failed dispatch does.
if ! git -C Fixture show-ref --verify --quiet refs/heads/m03; then
  git -C Fixture branch m03
  sed 's/M02/M03/g' "$ROOT/tests/project/docs/milestones/M02.md" > Fixture/docs/milestones/M03.md
  git -C Fixture add -- docs/milestones/M03.md
  GIT_AUTHOR_NAME=fixture GIT_AUTHOR_EMAIL=fixture@example GIT_AUTHOR_DATE=2026-09-01T00:00:00+0000 \
  GIT_COMMITTER_NAME=fixture GIT_COMMITTER_EMAIL=fixture@example GIT_COMMITTER_DATE=2026-09-01T00:00:00+0000 \
    git -C Fixture commit -q -m 'Record M03 brief'
fi
before=$(git -C Fixture rev-parse m03)
status=0
"$BATON" dispatch Fixture M03 || status=$?
test "$status" -eq 1
jq -se 'last | .kind == "dispatch_failed" and .stage == "worktree"' "$BATON_HOME/log.jsonl" > /dev/null
test "$(git -C Fixture rev-parse m03)" = "$before"
test -z "$(git -C Fixture-M03 status --porcelain)"
test ! -e Fixture-M03/docs/milestones/M03.md
printf '%s\n' 'Guard refused dispatch; branch and worktree unchanged.'
exit "$status"
