== redispatch retains the count but needs a new failure before acting ==
{"failures":0,"ineffective_failures":2,"next":"none","acted":true}
true
== a refused resume is the third failure across attempts ==
{"failures":1,"ineffective_failures":3,"next":"escalate","ending":"resume","acted":false}
true
== stop-failure consumed after the failure ==
{"failures":1,"ineffective_failures":3,"next":"escalate","ending":"resume","acted":false}
true
== session consumed after the failure ==
{"failures":0,"ineffective_failures":0,"next":"none","acted":true}
true
== a failure after progress restarts at resume ==
{"failures":1,"ineffective_failures":1,"next":"resume","ending":"consumed","acted":false}
true
== other lanes and delivered/forked resumes cannot reset this lane ==
{"failures":1,"ineffective_failures":3,"next":"escalate","ending":"resume","acted":true}
true
