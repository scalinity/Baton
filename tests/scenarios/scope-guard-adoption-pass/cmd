set -eu
echo "== The generated plan holds and its scope guard is dispatched; the guard hands over a pass. The next tick consumes the verdict and the one after adopts the plan through onboarding's own seeding path — the self-check then reads it, the park closes, and the plan's first milestone is dispatched. An aligned plan is adopted with no person asked =="
"$BATON" tick || true
sid=0badc0d1-0000-4000-8000-000000000000
mkdir -p "$BATON_HOME/inbox"
if ! ls "$BATON_HOME"/archive/M00-scope-$sid-*.json > /dev/null 2>&1; then
  printf '%s\n' "{\"baton\":1,\"project\":\"$PWD/Fixture\",\"milestone\":\"M00-scope\",\"session\":\"$sid\",\"outcome\":\"complete\",\"verdict\":\"pass\",\"finding\":\"The plan reads a note and says what it said, in shell. It serves the goal, keeps POSIX shell, and rewrites nothing in another language.\",\"written_at\":\"2026-09-19T08:00:00+01:00\"}" \
    > "$BATON_HOME/inbox/M00-scope-$sid.json"
fi
"$BATON" tick || true
"$BATON" tick || true
echo '--- the registration after the pass ---'
jq -c '{plan_format, owed: (.plan_owed != null), start: [(.start.eligible // [])[] | .milestone]}' "$BATON_HOME/projects/Fixture/project.json"
echo '--- what the ticks recorded ---'
jq -c 'select(.kind == "dispatch" or .kind == "plan_generation" or (.kind == "consumed" and .milestone == "M00-scope") or .kind == "escalation") | {kind, milestone, request, verdict, outcome}' "$BATON_HOME/log.jsonl"
