{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [],
    "deny": [
      "*"
    ]
  },
  "remoteControlAtStartup": true,
  "statusLine": {
    "type": "command",
    "command": "BATON_HOME='@TMP@/home' BATON_PROJECT='Fixture' BATON_MILESTONE='M00-scope' '@TMP@/home/bin/statusline'"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "BATON_HOME='@TMP@/home' BATON_PROJECT='Fixture' BATON_MILESTONE='M00-scope' '@TMP@/home/bin/stop-gate'"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "BATON_HOME='@TMP@/home' BATON_PROJECT='Fixture' BATON_MILESTONE='M00-scope' '@TMP@/home/bin/stop-failure'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/usr/bin/jq' -c '{hookSpecificOutput: {hookEventName: \"UserPromptSubmit\", additionalContext: (\"Your session id is \" + .session_id + \".\")}}'"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_CLAUDE_MDS": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  }
}
