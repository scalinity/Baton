printf '2026-09-12T16:30:00+01:00\n' > "$SHIM/now"
printf '%s\n' '{"session_id":"f1","model":{"id":"claude-opus-5"},"rate_limits":{"five_hour":{"used_percentage":93,"resets_at":1789243200},"seven_day":{"used_percentage":30,"resets_at":1789900000}}}' > "$BATON_HOME/status/f1.json"
