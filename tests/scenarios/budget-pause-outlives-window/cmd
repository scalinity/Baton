"$BATON" status
echo "-- two holds and one lift, each naming a window that was really holding --"
[ "$(grep -c '"kind":"hold","model":"all","cause":"budget"' "$BATON_HOME/log.jsonl")" = 2 ]
[ "$(grep -c '"kind":"hold_lifted","model":"all","cause":"budget"' "$BATON_HOME/log.jsonl")" = 1 ]
