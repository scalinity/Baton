echo "== The guard for M02's close-out has handed over a drift. The first tick consumes it and M03 stays held; the second parks the guard lane, once, and the Mac message reaches the person. A replan that rewrites the plan around the work does not release it, and neither does any later tick; a person's ruling does, and the tick after it dispatches M03 =="
sh "$ROOT/tests/completion-fixture.sh" valid
repo=$PWD/Fixture
"$BATON" tick || true
"$BATON" tick || true
echo '--- the drift park, as the log records it ---'
jq -c 'select(.kind == "escalation") | {milestone, session, attempt, class, scope, request: .carries.request, detail: .carries.detail}' "$BATON_HOME/log.jsonl"
echo '--- status ---'
"$BATON" status || true

echo '--- a replan: the plan and the brief rewritten on main around the drifted work. An edit releases'
echo '--- the classes it answers; drift is not one of them, so the park and the hold both stand'
if ! git -C "$repo" log --format=%s main | grep -qx 'a replan rewrites M03 around the web page'; then
  export GIT_AUTHOR_NAME=fixture GIT_AUTHOR_EMAIL=fixture@example GIT_AUTHOR_DATE=2026-09-03T00:00:00+0000 \
         GIT_COMMITTER_NAME=fixture GIT_COMMITTER_EMAIL=fixture@example GIT_COMMITTER_DATE=2026-09-03T00:00:00+0000
  blob=$(sed 's/CANARY-PLAN-RATIONALE/The web page is now the plan./' "$repo/docs/milestones/M03.md" | git -C "$repo" hash-object -w --stdin)
  GIT_INDEX_FILE=$repo/.git/replan-index; export GIT_INDEX_FILE
  rm -f "$GIT_INDEX_FILE"
  git -C "$repo" read-tree main
  git -C "$repo" update-index --add --cacheinfo "100644,$blob,docs/milestones/M03.md"
  tree=$(git -C "$repo" write-tree)
  unset GIT_INDEX_FILE
  git -C "$repo" update-ref refs/heads/main "$(git -C "$repo" commit-tree "$tree" -p main -m 'a replan rewrites M03 around the web page')"
fi
"$BATON" tick || true
jq -c 'select(.kind == "resolution") | {milestone, how}' "$BATON_HOME/log.jsonl"

echo '--- the person rules, and only that releases it ---'
"$BATON" answer Fixture/M00-scope "carry on: the web page was asked for after all" || true
"$BATON" tick || true
echo '--- what was dispatched, across all of it ---'
jq -c 'select(.kind == "dispatch") | {milestone, attempt}' "$BATON_HOME/log.jsonl"
echo '--- the Mac message the drift raised ---'
grep -F osascript "$BATON_SHIM/calls.log" || true
