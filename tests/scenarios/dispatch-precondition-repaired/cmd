set -eu
# The refusal is a state a person can leave: write the brief, commit it, and the same dispatch goes
# through and creates everything it was withholding. Then the worktree is reused with uncommitted
# work in it, because refusing early must not turn into discarding a branch-local edit.
if ! git -C Fixture show-ref --verify --quiet refs/heads/m03; then
  echo '--- the brief is written but not committed'
  sed 's/M02/M03/g' "$ROOT/tests/project/docs/milestones/M02.md" > Fixture/docs/milestones/M03.md
  status=0; "$BATON" dispatch Fixture M03 || status=$?
  test "$status" -eq 1
  test ! -e Fixture-M03
  test ! -e "$BATON_HOME/settings/Fixture-M03.json"
  echo 'refused, and no branch, worktree or settings file exists'

  echo '--- the repair: the same brief, committed on main'
  git -C Fixture add -- docs/milestones/M03.md
  GIT_AUTHOR_NAME=fixture GIT_AUTHOR_EMAIL=fixture@example GIT_AUTHOR_DATE=2026-09-01T00:00:00+0000 \
  GIT_COMMITTER_NAME=fixture GIT_COMMITTER_EMAIL=fixture@example GIT_COMMITTER_DATE=2026-09-01T00:00:00+0000 \
    git -C Fixture commit -q -m 'Record M03 brief'
  "$BATON" dispatch Fixture M03

  echo '--- a redispatch over uncommitted work in the reused worktree'
  printf 'work in progress\n' > Fixture-M03/scratch.txt
  jq 'map(.pid = null)' "$SHIM/rows.json" > "$SHIM/rows.json.tmp" && mv "$SHIM/rows.json.tmp" "$SHIM/rows.json"
  # The reuse line names the commit the branch stands at, which is the brief commit this scenario
  # made rather than the fixture commit the harness names, so it is given a name here too.
  reused=$("$BATON" dispatch Fixture M03)
  printf '%s\n' "$reused" | sed "s/$(git -C Fixture rev-parse m03)/@BRIEFCOMMIT@/"
  test "$(cat Fixture-M03/scratch.txt)" = 'work in progress'
  echo 'the uncommitted file is still there'
fi
jq -se '([.[] | select(.kind == "dispatch" and .milestone == "M03")] | length) == 2
        and ([.[] | select(.kind == "dispatch_failed" and .milestone == "M03")] | length) == 1' \
  "$BATON_HOME/log.jsonl" > /dev/null
echo 'one refusal, then two dispatches'
