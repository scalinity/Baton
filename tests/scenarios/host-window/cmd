echo
echo '=== the history is read once for as long as the lock is held, however many windows ask about'
echo '=== it, and read afresh once the lock is gone. Every probe above ran without one, which is why'
echo '=== each of them saw its own history.'
before=$(grep -c 'pmset -g log' "$SHIM/calls.log")
mkdir -p "$BATON_HOME/lock"
host_window "$from" "$to" 3600 60 > /dev/null
host_window "$from" "$to" 3600 60 > /dev/null
host_window "$((from - 86400))" "$((to - 86400))" 3600 60 > /dev/null
under=$(grep -c 'pmset -g log' "$SHIM/calls.log")
echo "three windows under one lock:  $((under - before)) read"
rm -rf "$BATON_HOME/lock"
host_window "$from" "$to" 3600 60 > /dev/null
