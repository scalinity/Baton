echo "one more with the lock gone:   $((after - under)) read"

echo
echo '=== and a read that failed is remembered as a failure, not retried until the lock goes. Both'
echo '=== answers below are history-unreadable and not no-transitions, which is what says the cached'
echo '=== line was read as a failure rather than as an empty history.'
printf '1\n' > "$SHIM/pmset.status"
