echo "inside an explained window:  [$proven]"
printf '1\n' > "$SHIM/pmset.status"
proven=$(host_sleep_proven "$from" "$to" 60)
echo "with the read failing:       [$proven]"
rm -f "$SHIM/pmset.status"
