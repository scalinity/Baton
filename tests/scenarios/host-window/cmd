set -eu
# The parser and the coverage policy, on their own, across every history shape §4 names. A verb
# would prove one of these per scenario; this drives them all against one window, so the boundary
# between "explained" and every kind of doubt is one readable table rather than twenty directories.
#
# The window is two hours, 10:00 to 12:00 on 2026-09-12 in +01:00, and the interval is sixty
# seconds, so two intervals — the threshold an awake portion has to stay under — is 120 s.
. "$ROOT/tests/lib-load.sh"

from=$(iso_epoch 2026-09-12T10:00:00+01:00)
to=$(iso_epoch 2026-09-12T12:00:00+01:00)

# Each case is read in a command substitution, which is a subshell, because the history is read once
# per process on purpose: the memo that makes "once per needed tick" true would otherwise make every
# case after the first read the first one's history.
#
# The jq program is one line and is not nested inside another substitution. /bin/sh here is bash 3.2
# and mistracks the quoting state of a multi-line quoted string inside `$( )` inside `" "`, which is
# the same hazard `stall_check` carries a note about.
probe() {
  pr_name=$1
  cat > "$SHIM/pmset.log"
  pr_out=$(host_window "$from" "$to" 3600 60)
  pr_sum=$(printf '%s' "$pr_out" | jq -c 'if .assessed == "unknown" then {assessed, reason} else {assessed, sleep_seconds, longest_awake_seconds, sleep_count} end')
  printf '%-26s %s\n' "$pr_name" "$pr_sum"
}

