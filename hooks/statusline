#!/bin/sh
# statusLine: writes stdin whole to status/<session_id>.json (.tmp then rename) and prints the
# status line. The status feed is telemetry: overwritten per turn, never appended.
set -eu
BATON_HOME=${BATON_HOME:-$HOME/.baton}

payload=$(cat)
sid=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null || true)
if [ -n "$sid" ]; then
  mkdir -p "$BATON_HOME/status"
  printf '%s\n' "$payload" > "$BATON_HOME/status/$sid.json.tmp"
  mv "$BATON_HOME/status/$sid.json.tmp" "$BATON_HOME/status/$sid.json"
fi
printf 'baton %s' "${BATON_MILESTONE:-?}"
exit 0
