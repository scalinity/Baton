#!/bin/sh
set -eu
BATON_HOME=${BATON_HOME:-$HOME/.baton}
payload=$(cat)
sid=$(printf '%s' "$payload"|jq -er '.session_id|select(type=="string" and test("^[A-Za-z0-9_-]+$"))' 2>/dev/null) || exit 0
mkdir -p "$BATON_HOME/status"
status_tmp=$(mktemp "$BATON_HOME/status/.feed.XXXXXX")
trap 'rm -f "$status_tmp"' EXIT
printf '%s\n' "$payload" > "$status_tmp"
mv "$status_tmp" "$BATON_HOME/status/$sid.json"
printf 'baton %s' "${BATON_MILESTONE:-?}"
