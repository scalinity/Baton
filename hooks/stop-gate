#!/bin/sh
set -eu
. "$(dirname "$0")/common.sh"
if printf '%s' "$payload"|jq -e '(.background_tasks // [])|length>0' >/dev/null; then exit 0; fi
fence=$(printf '%s\n' "$message"|awk '/^```baton[ \t]*$/ {f=1;next} f && /^```/ {exit} f')
if [ -n "$fence" ] && printf '%s' "$fence"|jq -e --arg s "$sid" --arg r "$BATON_RUN" '.session==$s and .run==$r and .baton==2' >/dev/null 2>&1; then
  # Keep the original ID: a callback after consumption is a re-delivery, not a new ending.
  printf '%s\n' "$fence"|"$hook_root/hooks/publish" && exit 0
fi
if ! printf '%s' "$payload"|jq -e '.stop_hook_active==true' >/dev/null; then
  jq -nc --arg run "$BATON_RUN" '{decision:"block",reason:("Publish and print a contract-2 handover for run "+$run+" with one stable message_id. Completion requires the integration receipt. Otherwise report asking or stopped.")}'
  exit 0
fi
ending=$(hook_envelope no-handover) || exit 0
hook_publish "$ending"
