#!/bin/sh
# baton — the relay's one script. Verb dispatch only; every verb's work lives under lib/.
# The seams are read here, once, and exported for the libraries and the shims.
set -eu

BATON_CLAUDE=${BATON_CLAUDE:-/Users/danny/.local/bin/claude}
BATON_DATE=${BATON_DATE:-date}
BATON_CAFFEINATE=${BATON_CAFFEINATE:-/usr/bin/caffeinate}
BATON_OSASCRIPT=${BATON_OSASCRIPT:-/usr/bin/osascript}
BATON_OPEN=${BATON_OPEN:-/usr/bin/open}
BATON_HOME=${BATON_HOME:-$HOME/.baton}
BATON_DAEMON_LOG=${BATON_DAEMON_LOG:-$HOME/.claude/daemon.log}
BATON_TRANSCRIPTS=${BATON_TRANSCRIPTS:-$HOME/.claude/projects}
BATON_JOBS=${BATON_JOBS:-$HOME/.claude/jobs}
export BATON_CLAUDE BATON_DATE BATON_CAFFEINATE BATON_OSASCRIPT BATON_OPEN BATON_HOME BATON_DAEMON_LOG \
  BATON_TRANSCRIPTS BATON_JOBS

here=$(cd "$(dirname "$0")" && pwd)

# The bundle this copy's libraries were published as. Empty here and rewritten by `install.sh` into
# the copy it installs, which is the whole of F08's repair (D-131).
#
# `install.sh` copies file by file and takes no lock, and this script sources its whole library set
# before the verb is read and long before any `lock_take` below — so an install landing while a tick
# is starting used to give that tick some libraries from the old set and some from the new, and no
# lock could have prevented it, because the sourcing is already over by the time one is taken. The
# repair is to make the library set immutable and name it: `install.sh` publishes each set once,
# under a directory named for its own content, and writes that name here. A copy of this script
# therefore sources the set it was installed with and no other, whatever is installed afterwards.
#
# The reference changes by one `rename(2)` over this file. A shell already reading the previous copy
# holds that inode open and reads it to the end unchanged, so it keeps naming the previous bundle,
# which `install.sh` keeps; a shell started afterwards opens the new copy and names the new one.
# There is no reading in between. An empty value is either the checkout or a relay installed before
# this scheme, where the libraries sit flat under bin/lib/ and are read from there.
baton_bundle=

# In the checkout the libraries sit beside bin/; in the installed relay they sit under bin/lib/.
if [ -d "$here/lib" ]; then
  BATON_LIB=$here/lib
  [ -z "$baton_bundle" ] || BATON_LIB=$here/lib/$baton_bundle
else
  BATON_LIB=$here/../lib
fi
. "$BATON_LIB/render.sh"
. "$BATON_LIB/lock.sh"
. "$BATON_LIB/log.sh"
. "$BATON_LIB/plan.sh"
. "$BATON_LIB/templates.sh"
. "$BATON_LIB/notify.sh"
. "$BATON_LIB/dispatch.sh"
. "$BATON_LIB/preconditions.sh"
. "$BATON_LIB/candidates.sh"
. "$BATON_LIB/derive.sh"
. "$BATON_LIB/completion.sh"
. "$BATON_LIB/inbox.sh"
. "$BATON_LIB/rows.sh"
. "$BATON_LIB/status.sh"
. "$BATON_LIB/escalate.sh"
. "$BATON_LIB/answer.sh"
. "$BATON_LIB/stops.sh"
. "$BATON_LIB/declared.sh"
. "$BATON_LIB/waits.sh"
. "$BATON_LIB/tick.sh"
. "$BATON_LIB/lifecycle.sh"
. "$BATON_LIB/onboard.sh"

# Before any verb: nothing Baton starts inherits the Claude Code session this may be running inside.
claude_env_clean

# And before any verb prints anything: the rendering context, read here because `[ -t 1 ]` asked
# inside a command substitution or a pipeline answers for that pipe rather than for the stream the
# verb is about to write to. Every library reads what this captures; nothing asks again.
render_init

# usage <out|err>: the eight verbs. The stream is an argument because the same eight rows are the
# answer to `baton help` on stdout and the refusal that follows a wrong argument on stderr, and
# only the caller knows which of the two this is. The verb column is padded before it is styled,
# because a width counts the escape bytes of a string that was styled first.
usage() {
  us_stream=$1
  render_heading "$us_stream" 'usage: baton <verb> ...\n'
  usage_row "$us_stream" 'tick' 'the eight steps for every registered project, then the marker'
  usage_row "$us_stream" 'answer <milestone> <ruling | n>' 'deliver a ruling into a parked lane; "continue" hands back a takeover'
  usage_row "$us_stream" 'status' 'the one view: parks, takeovers, waits, holds, in flight, the inbox'
  usage_row "$us_stream" 'plan <project>' 'print the graph as the tick sees it; validate every Model cell'
  usage_row "$us_stream" 'dispatch <project> <milestone>' 'step 8 by hand: worktree, settings, prompt, claude --bg, one event'
  usage_row "$us_stream" 'allow <milestone> '"'"'<rule>'"'" 'write the rule into the project'"'"'s allowlist and the live settings'
  usage_row "$us_stream" 'wake [<milestone> [<text>]]' 'bring a finished session back, carrying the text; with none, list them'
  usage_row "$us_stream" 'onboard <path>' 'register a Git repository, derive its rail and check, read its plan, confirm once'
}

usage_row() {
  render_row "$1" plain '  %s%s\n' "$(render_token "$1" verb "$(printf '%-35s' "$2")")" "$3"
}

verb=${1:-}
case "$verb" in
  tick)
    [ $# -eq 1 ] || { usage err; exit 2; }
    # The one verb that clears a stale lock rather than refusing over it: a lock past the interval
    # whose holder is gone would otherwise stop the relay until a person noticed (REQ-TICK-03).
    # The report runs after the break, so it speaks only for a lock still held by a live process —
    # a hand run that is taking its time — and `launchd.out` then says why the tick did nothing.
    stale=$(lock_stale_break)
    lock_stale_report
    lock_take
    verb_tick "$stale"
    ;;
  plan)
    [ $# -eq 2 ] || { usage err; exit 2; }
    lock_stale_report
    lock_take
    verb_plan "$2"
    ;;
  dispatch)
    [ $# -eq 3 ] || { usage err; exit 2; }
    lock_stale_report
    lock_take
    verb_dispatch "$2" "$3"
    ;;
  status)
    [ $# -eq 1 ] || { usage err; exit 2; }
    # Before anything else, so that a person reading the view sees why it is about to refuse.
    lock_stale_report
    lock_take
    verb_status
    ;;
  answer)
    # Two arguments exactly: the milestone and the ruling. A ruling of several words is one shell
    # argument, which is what the quotes in every message Baton sends are for.
    [ $# -eq 3 ] || { usage err; exit 2; }
    lock_stale_report
    lock_take
    verb_answer "$2" "$3"
    ;;
  allow)
    [ $# -eq 3 ] || [ $# -eq 4 ] || { usage err; exit 2; }
    if [ $# -eq 4 ] && [ "$4" != --resume ]; then
      render_failure err "baton: allow takes one flag, --resume; '$4' is not it"
      exit 2
    fi
    lock_stale_report
    lock_take
    verb_allow "$2" "$3" "${4:-}"
    ;;
  wake)
    # At most two arguments: the milestone and the text the woken session receives, which the wake
    # session quotes as one shell argument. With neither, the finished sessions are listed.
    [ $# -le 3 ] || { usage err; exit 2; }
    lock_stale_report
    lock_take
    verb_wake "${2:-}" "${3:-}"
    ;;
  onboard)
    # Under the lock like every verb, and for this one the lock is load-bearing in a second way: the
    # judgment request runs inside it, so a request that hangs would hold the relay. Its own deadline
    # is what bounds that, and `lock_stale_break` is what recovers from the case the deadline misses.
    [ $# -eq 2 ] || { usage err; exit 2; }
    lock_stale_report
    lock_take
    verb_onboard "$2"
    ;;
  ''|help|-h|--help)
    usage out
    ;;
  *)
    render_failure err "baton: unknown verb '$verb'"
    usage err
    exit 2
    ;;
esac
