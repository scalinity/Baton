#!/bin/sh
set -eu
umask 077
BATON_CLAUDE=${BATON_CLAUDE:-/Users/danny/.local/bin/claude}
BATON_DATE=${BATON_DATE:-date}
BATON_CAFFEINATE=${BATON_CAFFEINATE:-/usr/bin/caffeinate}
BATON_HOME=${BATON_HOME:-$HOME/.baton}
BATON_DAEMON_LOG=${BATON_DAEMON_LOG:-$HOME/.claude/daemon.log}
BATON_TRANSCRIPTS=${BATON_TRANSCRIPTS:-$HOME/.claude/projects}
export BATON_CLAUDE BATON_DATE BATON_CAFFEINATE BATON_HOME BATON_DAEMON_LOG BATON_TRANSCRIPTS
BATON_RELEASE_ROOT=$(cd "$(dirname "$0")/.." && pwd -P)
BATON_LIB=$BATON_RELEASE_ROOT/lib
unset BATON_LOCK_OWNER BATON_LOG_SNAPSHOT
for lib in lock log git adapter plan templates derive runs dispatch integrate inbox status; do . "$BATON_LIB/$lib.sh"; done
usage() {
  cat <<'USAGE'
usage: baton <verb>
  plan <project>                      validate the committed graph
  dispatch <project> <milestone>       prepare and launch one identified run
  status                              read a coherent journal; never takes the writer lock
  consume                             acknowledge immutable handovers; never stops a session
  reconcile                           reconcile uncertain launches, then consume
  claim <run> | release <run>          explicitly transfer ownership
  integrate <run> [--retry]           check/integrate; retry supersedes an unverified operation
  abandon <run> <reason>               resolve a run explicitly; preserves all work
  adopt <project> <milestone> <session> explicitly register a hand-started session as human-owned
  publish                             publish a contract-2 JSON message from stdin
  tick | answer                       scheduled policy is not implemented yet
USAGE
}
verb=${1:-}
case "$verb" in
  status) [ $# -eq 1 ] || exit 2; verb_status ;;
  plan) [ $# -eq 2 ] || exit 2; verb_plan "$2" ;;
  publish) [ $# -eq 1 ] || exit 2; exec "$BATON_RELEASE_ROOT/hooks/publish" ;;
  dispatch) [ $# -eq 3 ] || exit 2; lock_take; verb_dispatch "$2" "$3" ;;
  consume) [ $# -eq 1 ] || exit 2; lock_take; inbox_consume ;;
  reconcile) [ $# -eq 1 ] || exit 2; lock_take; rr_rows=$(rows_json) || exit 1; reconcile_dispatches "$rr_rows"; inbox_consume ;;
  claim|release) [ $# -eq 2 ] || exit 2; lock_take; verb_ownership "$verb" "$2" ;;
  integrate) [ $# -eq 2 ] || { [ $# -eq 3 ] && [ "$3" = --retry ]; } || exit 2; lock_take; verb_integrate "$2" "${3:-}" ;;
  abandon) [ $# -eq 3 ] || exit 2; lock_take; verb_abandon "$2" "$3" ;;
  adopt) [ $# -eq 4 ] || exit 2; lock_take; verb_adopt "$2" "$3" "$4" ;;
  tick|answer|allow) echo "baton: $verb is not implemented; see docs/MILESTONES.md" >&2; exit 2 ;;
  ''|help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
